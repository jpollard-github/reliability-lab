# Runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info

# Local infrastructure (non-secret development defaults)
DATABASE_URL=postgresql://reliability:reliability@localhost:5432/reliability_lab
REDIS_URL=redis://localhost:6379

# Execution. in_process is the zero-setup default. postgres_worker requires the
# database, migrations, a separately running worker, and the command keyring below.
EXECUTION_MODE=in_process
EXECUTION_COMMAND_ACTIVE_KEY_VERSION=v1
EXECUTION_COMMAND_KEYS_JSON={"v1":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI="}
WORKER_ID=
WORKER_HEALTH_PORT=4001
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=250
WORKER_LEASE_DURATION_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_SHUTDOWN_GRACE_MS=15000

# Telemetry
OTEL_SERVICE_NAME=reliability-lab-api
WORKER_OTEL_SERVICE_NAME=reliability-lab-worker
# Leave empty for the local console exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional OpenAI-compatible provider
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Replay vault. Memory is process-local and cannot retain live-provider prompts.
REPLAY_CAPSULE_STORE=memory
REPLAY_CAPSULE_RETENTION_HOURS=24
# Required only with REPLAY_CAPSULE_STORE=postgres. These are public, intentionally unsafe examples;
# generate separate 32-byte keys for local use and use managed key infrastructure in production.
REPLAY_CAPSULE_ACTIVE_KEY_VERSION=v2
REPLAY_CAPSULE_KEYS_JSON={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","v2":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}

# Unsafe development capabilities; both default to disabled.
ENABLE_FAILURE_INJECTION=false
ALLOW_LIVE_PROMPT_RETENTION=false
