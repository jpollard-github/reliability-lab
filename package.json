{
  "name": "reliability-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Replayable reliability experiments for OpenAI-compatible LLM systems",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:durable": "concurrently -n api,worker,web -c cyan,yellow,magenta \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:infra": "docker compose up -d --wait",
    "dev:api": "pnpm --filter @reliability-lab/api dev",
    "dev:worker": "pnpm --filter @reliability-lab/worker dev",
    "dev:web": "pnpm --filter @reliability-lab/web dev",
    "start:worker": "pnpm --filter @reliability-lab/worker start",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude 'apps/web/tests/**' --exclude '**/dist/**'",
    "test:integration": "vitest run packages/db/test/repository.integration.test.ts packages/db/test/durable-execution.integration.test.ts",
    "test:e2e": "pnpm --filter @reliability-lab/web test:e2e",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "verify:full": "pnpm verify && pnpm test:integration && pnpm test:e2e",
    "audit:deps": "pnpm audit --prod",
    "audit:unused": "knip",
    "audit": "pnpm audit:deps && pnpm audit:unused",
    "db:generate": "pnpm --filter @reliability-lab/db db:generate",
    "db:migrate": "pnpm --filter @reliability-lab/db db:migrate",
    "db:studio": "pnpm --filter @reliability-lab/db db:studio",
    "export:repo": "node scripts/export-repo.mjs",
    "export:working": "node scripts/export-working-files.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "glob": "^13.0.0",
    "globals": "^16.0.0",
    "knip": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
